{
  "name": "exhale",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "dotenv -e .env -- pnpm --filter web dev",
    "build": "dotenv -e .env -- pnpm --filter web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "dotenv -e .env -- pnpm --filter @exhale/db generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @exhale/db migrate"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "sharp": "^0.35.2",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
      "js-yaml": "4.3.1",
      "nanoid@<3.3.17": "3.3.17",
      "postcss": "8.5.26",
      "protobufjs": "7.6.5",
      "sharp": "0.35.3",
      "shell-quote": "1.10.0",
      "tar": "7.5.22",
      "undici@<6.28.0": "6.28.0",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "uuid": "^11.1.1",
      "next@>=16.0.0 <16.2.11": "16.2.11"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2025-71330",
        "CVE-2025-71329"
      ]
    }
  }
}
