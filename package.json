{
  "name": "bridge",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "dotenv -e .env -- pnpm --filter web dev",
    "build": "dotenv -e .env -- pnpm --filter web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "dotenv -e .env -- pnpm --filter @bridge/db generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @bridge/db migrate"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "sharp": "^0.35.2",
    "typescript": "^5.6.0"
  }
}
