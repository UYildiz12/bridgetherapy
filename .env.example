# Exhale environment variables
# Copy to .env and fill in values from Supabase and Google AI Studio.

# Supabase Postgres
DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Supabase API
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Google Gemini API, used by server-side AI summaries.
AI_key="<google-ai-studio-api-key>"

# Bearer secret required by POST /api/cron/reminders. The endpoint fails closed
# (always 401) when unset. Set the same value in the Vercel project env.
# CRON_SECRET="<long-random-string>"

# Webhook that receives push notification payloads from the reminders cron.
# Deliveries are skipped when unset.
# PUSH_WEBHOOK_URL="https://<push-provider>/webhook"

# Jitsi domain for session video links. Defaults to meet.jit.si when unset.
# NEXT_PUBLIC_JITSI_DOMAIN="meet.jit.si"

# Gemini model overrides. Both default to gemini-3.1-flash-lite when unset.
# GEMINI_HOMEWORK_MODEL="gemini-3.1-flash-lite"
# LUMEN_MODEL="gemini-3.1-flash-lite"

# Base URL the Expo mobile app uses to reach the web API.
# Defaults to http://localhost:3000 when unset.
# EXPO_PUBLIC_API_BASE_URL="http://localhost:3000"
