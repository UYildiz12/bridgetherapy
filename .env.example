# ===================================
# MindfulPath Environment Variables
# ===================================
# Copy this file to .env and fill in the values

# Database
DATABASE_URL="postgresql://therapy_user:therapy_local_password@localhost:5432/therapy_db"

# Redis
REDIS_URL="redis://localhost:6379"

# S3/MinIO (Local Development)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin123"
S3_BUCKET="therapy-uploads"
S3_REGION="us-east-1"

# Auth (OIDC Provider - Auth0/Clerk/etc.)
# Configure with your chosen provider
OIDC_ISSUER_URL=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_AUDIENCE=""

# JWT (for internal tokens)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# API Server
API_PORT=3001
API_URL="http://localhost:3001"
NODE_ENV="development"

# Web Dashboard
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# Mobile App
# Note: Use 10.0.2.2 for Android emulator, localhost for iOS simulator
MOBILE_API_URL="http://10.0.2.2:3001"

# Video Conferencing (Daily.co/Twilio/Agora)
# Configure with your chosen provider
VIDEO_PROVIDER="daily"
VIDEO_API_KEY=""
VIDEO_API_SECRET=""

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# Monitoring & Analytics
SENTRY_DSN=""
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# Encryption (for E2E encrypted journal)
# This is a server-side backup key, actual encryption uses client keys
ENCRYPTION_MASTER_KEY=""
